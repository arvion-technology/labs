{
  "openapi": "3.0.3",
  "info": {
    "title": "Northwind API",
    "version": "1.0.0",
    "description": "A typed .NET 8 minimal API for customers and orders. Pagination, sorting, validation and RFC 7807 problem details. The repository is in-memory and seeded with deterministic data.",
    "license": { "name": "MIT", "url": "https://opensource.org/licenses/MIT" }
  },
  "servers": [{ "url": "http://localhost:5080", "description": "Local development" }],
  "tags": [
    { "name": "Customers", "description": "Customer records and their orders." },
    { "name": "Orders", "description": "Orders and the cancel transition." },
    { "name": "Meta", "description": "Health, discovery and the OpenAPI document." }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Meta"],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is running.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/api": {
      "get": {
        "tags": ["Meta"],
        "summary": "Discover the API",
        "responses": {
          "200": {
            "description": "Name, version and the endpoint list.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiInfo" } } }
          }
        }
      }
    },
    "/openapi/v1.json": {
      "get": {
        "tags": ["Meta"],
        "summary": "This document",
        "responses": { "200": { "description": "OpenAPI JSON." } }
      }
    },
    "/api/customers": {
      "get": {
        "tags": ["Customers"],
        "summary": "List customers",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Matches name, email or country." },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["name", "country", "tier", "createdAt"], "default": "createdAt" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } }
        ],
        "responses": {
          "200": {
            "description": "One page of customers.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerPage" } } }
          },
          "400": {
            "description": "Invalid paging or sort parameters.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ValidationProblem" } } }
          }
        }
      },
      "post": {
        "tags": ["Customers"],
        "summary": "Create a customer",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCustomer" } } }
        },
        "responses": {
          "201": {
            "description": "Customer created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } }
          },
          "400": {
            "description": "Validation failed.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ValidationProblem" } } }
          },
          "409": {
            "description": "Email already exists.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/customers/{id}": {
      "get": {
        "tags": ["Customers"],
        "summary": "Get a customer",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "The customer.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "404": { "description": "No such customer.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/customers/{id}/orders": {
      "get": {
        "tags": ["Customers"],
        "summary": "List a customer's orders",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } }
        ],
        "responses": {
          "200": { "description": "One page of orders.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderPage" } } } },
          "404": { "description": "No such customer.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List orders",
        "parameters": [
          { "name": "customerId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["placedAt", "total", "status"], "default": "placedAt" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } }
        ],
        "responses": {
          "200": { "description": "One page of orders.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderPage" } } } },
          "400": { "description": "Invalid paging, sort or status.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ValidationProblem" } } } }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Create an order",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrder" } } }
        },
        "responses": {
          "201": { "description": "Order created in the pending state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "description": "Validation failed.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ValidationProblem" } } } },
          "404": { "description": "Customer does not exist.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get an order",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "The order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "description": "No such order.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/orders/{id}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancel a pending order",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "The cancelled order.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "description": "No such order.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Order is no longer pending.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "service": { "type": "string", "example": "northwind-api" },
          "version": { "type": "string", "example": "1.0.0" }
        }
      },
      "ApiInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "documentation": { "type": "string" },
          "endpoints": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["id", "name", "email", "country", "tier", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 80 },
          "email": { "type": "string", "format": "email" },
          "country": { "type": "string" },
          "tier": { "type": "string", "enum": ["free", "growth", "enterprise"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateCustomer": {
        "type": "object",
        "required": ["name", "email", "country"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "email": { "type": "string", "format": "email" },
          "country": { "type": "string", "minLength": 2, "maxLength": 56 },
          "tier": { "type": "string", "enum": ["free", "growth", "enterprise"], "default": "free" }
        }
      },
      "OrderLineInput": {
        "type": "object",
        "required": ["productId", "productName", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "format": "uuid" },
          "productName": { "type": "string", "maxLength": 60 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 25 },
          "unitPrice": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 }
        }
      },
      "CreateOrder": {
        "type": "object",
        "required": ["customerId", "lines"],
        "properties": {
          "customerId": { "type": "string", "format": "uuid" },
          "lines": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/components/schemas/OrderLineInput" } }
        }
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "productId": { "type": "string", "format": "uuid" },
          "productName": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPrice": { "type": "number" },
          "lineTotal": { "type": "number" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customerId": { "type": "string", "format": "uuid" },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/OrderLine" } },
          "status": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] },
          "total": { "type": "number" },
          "placedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Customer" } },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 problem details.",
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        }
      },
      "ValidationProblem": {
        "allOf": [{ "$ref": "#/components/schemas/Problem" }],
        "type": "object",
        "properties": {
          "errors": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
